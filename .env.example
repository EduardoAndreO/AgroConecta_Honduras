# ============================================================
# AgroConecta Honduras — Variables de entorno
# Copia este archivo como .env en cada servicio
# ============================================================

# Base de datos PostgreSQL 16 + PostGIS
DATABASE_URL=postgresql+asyncpg://agro:agro123@localhost:5432/agroconecta
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agroconecta
DB_USER=agro
DB_PASSWORD=agro123

# Redis 7 (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT — generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_aleatorio_de_64_caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,http://localhost:5173

# Servicios — puertos locales
AUTH_SERVICE_PORT=8001
MARKETPLACE_SERVICE_PORT=8002
PAYMENTS_SERVICE_PORT=8003
NOTIFICATIONS_SERVICE_PORT=8004
GATEWAY_PORT=8000

# BAC Credomatic (sandbox — dejar vacío para mock)
BAC_API_URL=
BAC_API_KEY=

# WhatsApp Business (dejar vacío para mock)
WA_API_URL=
WA_TOKEN=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO
